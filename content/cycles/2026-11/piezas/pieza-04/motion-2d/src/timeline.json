  {
   "seg": "s1",
   "id": "s1a",
   "text": "¿Sabías que noviembre y diciembre llegan a sumar el veintidós por ciento de tus ventas?",
   "start": 0.2,
   "dur": 4.972
  },
  {
   "seg": "s2",
   "id": "s2a",
   "text": "Dani tiene un pequeño negocio.",
   "start": 5.372,
